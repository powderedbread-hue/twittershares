class SAM_UL_items(bpy.types.UIList):
    def draw_item(self, context, layout, data, item, icon, active_data, active_propname, index):
        if item is None:
            return

        row = layout.row(align=True)

        # Use preview icon if available
        if item.icon_id != 0:
            icon_args = {"icon_value": item.icon_id}
        else:
            icon_args = {"icon": 'FILE_FOLDER' if item.is_dir else 'FILE_IMAGE'}

        # icon button enters the folder on one click
        if item.is_dir:
            row.operator("sam.enter_folder", text="", emboss=False, **icon_args).index = index
        else:
            row.label(text="", **icon_args)

        sub = row.row(align=True)
        sub.alignment = 'LEFT'
        sub.operator("sam.item_click", text=item.name, emboss=False).index = index
        # invisible button fills the blank space so it is clickable too
        row.operator("sam.item_click", text="", emboss=False).index = index


