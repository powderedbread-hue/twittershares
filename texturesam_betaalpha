class SAM_OT_rotate_mapping_90(bpy.types.Operator):
    bl_idname = "sam.rotate_mapping_90"
    bl_label = "Rotate Mapping 90 Degrees"
    bl_description = "Rotate texture mapping by 90 degrees"
    bl_options = {'REGISTER', 'UNDO'}

    direction: bpy.props.IntProperty(default=1, options={'HIDDEN'})

    def execute(self, context):
        obj = context.object
        mat = obj.active_material if obj and obj.type == 'MESH' else None
        if not mat or not mat.use_nodes:
            self.report({'WARNING'}, "Active object has no node material")
            return {'CANCELLED'}

        nodes = SAM_get_edit_nodes(context, mat)
        mapping = next(
            (node for node in nodes or () if node.type == 'MAPPING'),
            None,
        )
        if not mapping:
            self.report({'WARNING'}, "Active material has no Mapping node")
            return {'CANCELLED'}

        rotation = mapping.inputs['Rotation'].default_value
        rotation_degrees = math.degrees(rotation[2]) + self.direction * 90
        rotation_degrees = round(rotation_degrees / 90) * 90
        rotation[2] = math.radians(rotation_degrees)
        mapping.inputs['Rotation'].default_value = rotation
        return {'FINISHED'}


class SAM_OT_add_hsl(bpy.types.Operator):
    bl_idname = "sam.add_hsl"
    bl_label = "Add HSL"
    bl_options = {'REGISTER', 'UNDO'}
    bl_description = "Add an HSL node to base color"

    def execute(self, context):
        processed_materials = set()
        inserted = 0

        for obj in context.selected_objects:
            mat = obj.active_material
            if not mat or not mat.use_nodes:
                continue

            material_id = mat.as_pointer()
            if material_id in processed_materials:
                continue
            processed_materials.add(material_id)

            nodes = SAM_get_edit_nodes(context, mat)
            if not nodes:
                continue
            links = nodes[0].id_data.links
            material_inserted = 0
            for bsdf in (node for node in nodes if node.type == 'BSDF_PRINCIPLED'):
                base_color = bsdf.inputs.get('Base Color')
                if not base_color or not base_color.is_linked:
                    continue

                source_link = base_color.links[0]
                source_node = source_link.from_node
                source_socket = source_link.from_socket
                hsl = nodes.new('ShaderNodeHueSaturation')
                hsl.location = (
                    source_node.location.x + source_node.width + 40,
                    source_node.location.y,
                )

                links.remove(source_link)
                links.new(source_socket, hsl.inputs['Color'])
                links.new(hsl.outputs['Color'], base_color)
                material_inserted += 1
                inserted += 1

            if material_inserted:
                for node in nodes:
                    if node.type in {'BSDF_PRINCIPLED', 'OUTPUT_MATERIAL', 'GROUP_OUTPUT'}:
                        node.location.x += 200

        if inserted:
            self.report({'INFO'}, f"Added HSL node to {inserted} Base Color connection(s)")
            return {'FINISHED'}

        self.report({'WARNING'}, "No selected material had a linked Principled BSDF Base Color")
        return {'CANCELLED'}


class SAM_OT_add_sky_texture(bpy.types.Operator):
    bl_idname = "sam.add_sky_texture"
    bl_label = "Add Sky Texture"
    bl_options = {'REGISTER', 'UNDO'}
    bl_description = "Add a Sky Node to World"

    def execute(self, context):
        world = context.scene.world
        if world is None:
            world = bpy.data.worlds.new(name="World")
            context.scene.world = world

        world.use_nodes = True
        nodes = world.node_tree.nodes
        links = world.node_tree.links

        background = next((node for node in nodes if node.type == 'BACKGROUND'), None)
        if background is None:
            background = nodes.new('ShaderNodeBackground')
            background.location = (0, 0)

        world_output = next(
            (node for node in nodes if node.type == 'OUTPUT_WORLD' and node.is_active_output),
            None,
        )
        if world_output is None:
            world_output = nodes.new('ShaderNodeOutputWorld')
            world_output.location = (300, 0)
            links.new(background.outputs['Background'], world_output.inputs['Surface'])
        elif not world_output.inputs['Surface'].is_linked:
            links.new(background.outputs['Background'], world_output.inputs['Surface'])

        sky = nodes.new('ShaderNodeTexSky')
        sky.location = (background.location.x - sky.width - 40, background.location.y)

        color_input = background.inputs['Color']
        for link in list(color_input.links):
            links.remove(link)
        links.new(sky.outputs['Color'], color_input)

        self.report({'INFO'}, "Sky Texture connected to the world Background")
        return {'FINISHED'}


class SAM_OT_open_shader_editor(bpy.types.Operator):
    bl_idname = "sam.open_shader_editor"
    bl_label = "Shader Editor"
    bl_description = "Open a new Shader Editor"

    def execute(self, context):
        existing_windows = {window.as_pointer() for window in context.window_manager.windows}
        result = bpy.ops.wm.window_new()
        if 'FINISHED' not in result:
            self.report({'ERROR'}, "Could not create a new window")
            return {'CANCELLED'}

        new_window = next(
            (
                window for window in context.window_manager.windows
                if window.as_pointer() not in existing_windows
            ),
            None,
        )
        if new_window is None:
            self.report({'ERROR'}, "New window was not available")
            return {'CANCELLED'}

        area = max(new_window.screen.areas, key=lambda item: item.width * item.height)
        area.type = 'NODE_EDITOR'
        area.ui_type = 'ShaderNodeTree'
        area.spaces.active.shader_type = 'OBJECT'
        return {'FINISHED'}


