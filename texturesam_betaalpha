def register():
    for cls in classes:
        try:
            bpy.utils.register_class(cls)
        except:
            pass

    #name settings here to sam_settings
    bpy.types.Scene.sam_settings = bpy.props.PointerProperty(type=SAM_Settings)
    bpy.types.ShaderNodeGroup.sam_layer_opacity = bpy.props.FloatProperty(
        name="Opacity",
        min=0.0,
        max=1.0,
        get=SAM_get_layer_opacity,
        set=SAM_set_layer_opacity,
    )
    scene = bpy.context.scene
    if hasattr(scene, "doon_settings"):
        SAM_refresh_list(scene.sam_settings)

#icon previews
    global preview_collection
    preview_collection = bpy.utils.previews.new()


def unregister():
    for cls in reversed(classes):
        try:
            bpy.utils.unregister_class(cls)
        except:
            pass
    #unregister settings here to
    del bpy.types.Scene.sam_settings
    del bpy.types.ShaderNodeGroup.sam_layer_opacity

    global preview_collection
    bpy.utils.previews.remove(preview_collection)
    preview_collection = None




if __name__ == "__main__":
    register()



        
        


