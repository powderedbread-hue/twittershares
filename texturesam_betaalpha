import time
_last_click_time = 0
_last_click_index = -1

class SAM_OT_item_click(bpy.types.Operator):
    bl_idname = "sam.item_click"
    bl_label = "Click Item"

    index: bpy.props.IntProperty()

    def execute(self, context):
        global _last_click_time, _last_click_index

        settings = context.scene.sam_settings
        item = settings.items[self.index]

        settings.active_index = self.index

        now = time.time()
        double = (self.index == _last_click_index and (now - _last_click_time) < 0.30)
        _last_click_time = now
        _last_click_index = self.index

        if not double:
            return {'FINISHED'}

        # Double-click → Make PBR
        if item.is_dir:
            base = bpy.path.abspath(settings.folder_path)
            folder_path = os.path.join(base, item.name)
            if any(os.path.isdir(os.path.join(folder_path, name)) for name in os.listdir(folder_path)):
                settings.folder_path = folder_path
                return {'FINISHED'}

            bpy.ops.sam.make_pbr(folder_path=folder_path)
            return {'FINISHED'}

        # Double-click on an image file → single image material
        bpy.ops.sam.make_pbr(
            folder_path=os.path.join(bpy.path.abspath(settings.folder_path), item.name)
        )
        return {'FINISHED'}


class SAM_OT_make_pbr(bpy.types.Operator):
    bl_idname = "sam.make_pbr"
    bl_label = "Make PBR Material"
    bl_description = "Create a PBR material from the selected folder"

    folder_path: bpy.props.StringProperty(options={'HIDDEN'})

    def execute(self, context):
        settings = context.scene.sam_settings
        folder_path = self.folder_path
        if not folder_path:
            if not 0 <= settings.active_index < len(settings.items):
                self.report({'ERROR'}, "Select a texture folder first")
                return {'CANCELLED'}

            item = settings.items[settings.active_index]

            folder_path = os.path.join(
                bpy.path.abspath(settings.folder_path),
                item.name,
            )

        single_image = os.path.isfile(folder_path)

        mapping_scale = settings.mapping_scale if settings.keep_scale else 1.0
        mapping_rotation = 0.0
        height_scale = 0.1

        obj = context.object
        source_material = obj.active_material if obj and obj.type == 'MESH' else None
        projection_style = (
            SAM_get_projection_style(context, source_material)
            if source_material and source_material.use_nodes else None
        ) or settings.projection_style
        if settings.keep_rot and source_material and source_material.use_nodes:
            source_mapping = next(
                (node for node in source_material.node_tree.nodes if node.type == 'MAPPING'),
                None,
            )
            if source_mapping:
                mapping_rotation = source_mapping.inputs['Rotation'].default_value[2]
        if settings.keep_height and source_material and source_material.use_nodes:
            source_disp = next(
                (node for node in SAM_get_edit_nodes(context, source_material) or ()
                 if node.type == 'DISPLACEMENT'),
                None,
            )
            if source_disp:
                height_scale = source_disp.inputs['Scale'].default_value

        if not os.path.exists(folder_path):
            self.report({'ERROR'}, "Folder does not exist")
            return {'CANCELLED'}

        # Build suffix map using your existing suffix detector
        suffix_map = {
            "ao": None,
            "color": None,
            "roughness": None,
            "normal": None,
            "metallic": None,
            "alpha": None,
            "height": None,
            "emission": None,
        }

        # Scan folder (a single image file counts as the color map)
        if single_image:
            files = [folder_path]
        else:
            files = [os.path.join(folder_path, f) for f in os.listdir(folder_path)]

        for full in files:
            if not os.path.isfile(full):
                continue

            if single_image:
                category = "color"
            else:
                category = SAM_detect_suffix(os.path.basename(full), SAM_SUFFIXES)
            if category and category in suffix_map:
                try:
                    img = bpy.data.images.load(full, check_existing=True)
                    suffix_map[category] = img
                except:
                    pass

        # Create material
        mat_name = os.path.basename(folder_path)
        if single_image:
            mat_name = os.path.splitext(mat_name)[0]
        mat = bpy.data.materials.new(mat_name)
        mat.use_nodes = True
        nodes = mat.node_tree.nodes
        links = mat.node_tree.links
        mat.displacement_method = 'DISPLACEMENT'

        # Clear default nodes
        for n in nodes:
            nodes.remove(n)

        # Create BSDF + Output
        bsdf = nodes.new("ShaderNodeBsdfPrincipled")
        bsdf.location = (0, 0)

        out = nodes.new("ShaderNodeOutputMaterial")
        out.location = (300, 0)
        links.new(bsdf.outputs["BSDF"], out.inputs["Surface"])

        x = -500
        y = 200
        y_step = -300

        # Texture Coordinate + Mapping
        texcoord = nodes.new("ShaderNodeTexCoord")
        texcoord.location = (-900, 300)

        mapping = nodes.new("ShaderNodeMapping")
        mapping.location = (-700, 300)
        mapping.inputs["Scale"].default_value = (mapping_scale, mapping_scale, mapping_scale)
        mapping.inputs["Rotation"].default_value = (0.0, 0.0, mapping_rotation)

        coordinate_socket = texcoord.outputs[
            "Object" if projection_style == 'BOX' else "UV"
        ]
        links.new(coordinate_socket, mapping.inputs["Vector"])

        texture_nodes = []


            # AO
        tex_color = None
        tex_ao = None

        if suffix_map["ao"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["ao"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'
            texture_nodes.append(tex)
            tex_ao = tex
            y += y_step

        # COLOR
        if suffix_map["color"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["color"]
            tex.location = (x, y)
            links.new(tex.outputs["Color"], bsdf.inputs["Base Color"])
            texture_nodes.append(tex)
            tex_color = tex
            y += y_step

        # AO MULTIPLY
        if tex_color and tex_ao:
            multiply = nodes.new("ShaderNodeMixRGB")
            multiply.blend_type = 'MULTIPLY'
            multiply.location = (x + 300, 200)

            links.new(tex_color.outputs["Color"], multiply.inputs["Color1"])
            links.new(tex_ao.outputs["Color"], multiply.inputs["Color2"])

            # Result → Base Color
            links.new(multiply.outputs["Color"], bsdf.inputs["Base Color"])

        else:
            # No AO → direct color
            if tex_color:
                links.new(tex_color.outputs["Color"], bsdf.inputs["Base Color"])



        # ROUGHNESS
        if suffix_map["roughness"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["roughness"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'
            links.new(tex.outputs["Color"], bsdf.inputs["Roughness"])
            texture_nodes.append(tex)
            y += y_step

        # NORMAL
        if suffix_map["normal"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["normal"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'

            normal_map = nodes.new("ShaderNodeNormalMap")
            normal_map.location = (x + 300, y)

            links.new(tex.outputs["Color"], normal_map.inputs["Color"])
            links.new(normal_map.outputs["Normal"], bsdf.inputs["Normal"])
            texture_nodes.append(tex)
            y += y_step

        # METALLIC
        if suffix_map["metallic"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["metallic"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'
            links.new(tex.outputs["Color"], bsdf.inputs["Metallic"])
            texture_nodes.append(tex)
            y += y_step

        # ALPHA
        if suffix_map["alpha"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["alpha"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'
            links.new(tex.outputs["Color"], bsdf.inputs["Alpha"])
            texture_nodes.append(tex)
            y += y_step

        # EMISSION
        if suffix_map["emission"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["emission"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'
            links.new(tex.outputs["Color"], bsdf.inputs["Emission Color"])
            bsdf.inputs["Emission Strength"].default_value = 1.0
            texture_nodes.append(tex)
            y += y_step

        

        # HEIGHT / DISPLACEMENT
        if suffix_map["height"]:
            tex = nodes.new("ShaderNodeTexImage")
            tex.image = suffix_map["height"]
            tex.location = (x, y)
            tex.image.colorspace_settings.name = 'Non-Color'

            disp = nodes.new("ShaderNodeDisplacement")
            disp.location = (x + 300, y)

            links.new(tex.outputs["Color"], disp.inputs["Height"])
            links.new(disp.outputs["Displacement"], out.inputs["Displacement"])
            disp.inputs['Scale'].default_value = height_scale
            #disp.inputs['Scale'].default_value = 0
            disp.inputs['Midlevel'].default_value = 0.5
            texture_nodes.append(tex)
            y += y_step
        else:
            # No height map: still add the node; Height = Midlevel gives zero net displacement
            disp = nodes.new("ShaderNodeDisplacement")
            disp.location = (x + 300, y)
            links.new(disp.outputs["Displacement"], out.inputs["Displacement"])
            disp.inputs['Height'].default_value = 1
            #disp.inputs['Scale'].default_value = height_scale
            disp.inputs['Scale'].default_value = 0
            disp.inputs['Midlevel'].default_value = 0.5
            y += y_step

        # Connect Mapping → all texture nodes
        for tex in texture_nodes:
            tex.projection = 'BOX' if projection_style == 'BOX' else 'FLAT'
            if "Vector" in tex.inputs:
                links.new(mapping.outputs["Vector"], tex.inputs["Vector"])

        #apply to selected polygons
        if context.mode == 'EDIT_MESH':
            import bmesh

            edited_meshes = set()
            assigned_faces = 0
            for obj in context.objects_in_mode:
                if obj.type != 'MESH':
                    continue

                mesh_id = obj.data.as_pointer()
                if mesh_id in edited_meshes:
                    continue
                edited_meshes.add(mesh_id)

                obj.data.materials.append(mat)
                material_index = len(obj.data.materials) - 1
                edit_mesh = bmesh.from_edit_mesh(obj.data)
                selected_faces = [face for face in edit_mesh.faces if face.select]
                for face in selected_faces:
                    face.material_index = material_index
                assigned_faces += len(selected_faces)
                bmesh.update_edit_mesh(obj.data, loop_triangles=False, destructive=False)

            if not assigned_faces:
                self.report({'WARNING'}, "No faces selected; material was created but not assigned")
                return {'CANCELLED'}
        else:
            # Assign to selected mesh objects
            for obj in context.selected_objects:
                if obj.type == 'MESH':
                    if len(obj.data.materials) == 0:
                        obj.data.materials.append(mat)
                    else:
                        obj.active_material = mat


        self.report({'INFO'}, f"Created PBR material '{mat_name}'")
        return {'FINISHED'}


class SAM_OT_blank_material(bpy.types.Operator):
    bl_idname = "sam.blank_material"
    bl_label = "Blank Material"
    bl_options = {'REGISTER', 'UNDO'}
    bl_description = "Create a default material named mat_basic and apply it to selected objects"

    def execute(self, context):
        objs = [o for o in context.selected_objects if o.type == 'MESH']
        if not objs:
            self.report({'WARNING'}, "Select a mesh object first")
            return {'CANCELLED'}

        mat = bpy.data.materials.new("mat_basic")
        mat.use_nodes = True
        mat.displacement_method = 'DISPLACEMENT'

        nodes = mat.node_tree.nodes
        out = next((n for n in nodes if n.type == 'OUTPUT_MATERIAL'), None)
        if out:
            disp = nodes.new("ShaderNodeDisplacement")
            disp.location = (out.location.x - 200, out.location.y - 200)
            disp.inputs['Height'].default_value = 1
            #disp.inputs['Scale'].default_value = 0.1
            disp.inputs['Scale'].default_value = 0
            disp.inputs['Midlevel'].default_value = 0.5
            mat.node_tree.links.new(disp.outputs["Displacement"], out.inputs["Displacement"])

        for obj in objs:
            if obj.data.materials:
                obj.active_material = mat
            else:
                obj.data.materials.append(mat)
        return {'FINISHED'}


