def SAM_folder_update(self, context):
    # Called automatically when folder_path changes
    settings = context.scene.sam_settings
    SAM_refresh_list(settings)

def SAM_ensure_layer_color_attribute(obj, layer_node):
    layer_name = layer_node.label or layer_node.name
    color_attributes = obj.data.color_attributes
    color_attribute = color_attributes.get(layer_name)
    if color_attribute is None:
        color_attribute = color_attributes.new(
            name=layer_name,
            type='BYTE_COLOR',
            domain='CORNER',
        )
    color_attributes.active_color = color_attribute

    group_nodes = layer_node.node_tree.nodes
    color_node = next(
        (node for node in group_nodes if node.type == 'VERTEX_COLOR'),
        None,
    )
    if color_node is None:
        color_node = group_nodes.new('ShaderNodeVertexColor')
    color_node.layer_name = layer_name

    mix_shader = next(
        (node for node in group_nodes if node.type == 'MIX_SHADER'),
        None,
    )
    if mix_shader:
        color_node.location = (
            mix_shader.location.x - 250,
            mix_shader.location.y + 250,
        )

def SAM_has_layer_name(node):
    # sam_layer is set on layers so renamed ones are still recognised
    return bool(node.get('sam_layer')) or (node.label or node.name).startswith('Layer_')

def SAM_get_surface_source_node(mat):
    output = next(
        (node for node in mat.node_tree.nodes
         if node.type == 'OUTPUT_MATERIAL' and node.is_active_output),
        None,
    )
    surface = output.inputs['Surface'] if output else None
    return surface.links[0].from_node if surface and surface.is_linked else None

def SAM_get_projection_style(context, material=None):
    obj = context.object
    mat = material or (obj.active_material if obj and obj.type == 'MESH' else None)
    if not mat or not mat.use_nodes:
        return None

    nodes = SAM_get_edit_nodes(context, mat) or ()
    image_nodes = [node for node in nodes if node.type == 'TEX_IMAGE']
    if image_nodes:
        return 'BOX' if any(node.projection == 'BOX' for node in image_nodes) else 'UV'

    mapping = next((node for node in nodes if node.type == 'MAPPING'), None)
    vector = mapping.inputs.get('Vector') if mapping else None
    if vector and vector.is_linked:
        source = vector.links[0]
        if source.from_node.type == 'TEX_COORD' and source.from_socket.name == 'Object':
            return 'BOX'
        if source.from_socket.name == 'UV':
            return 'UV'
    return None

def SAM_get_edit_nodes(context, material=None):
    obj = context.object
    mat = material or (obj.active_material if obj and obj.type == 'MESH' else None)
    if not mat or not mat.use_nodes:
        return None

    material_nodes = mat.node_tree.nodes
    settings = getattr(context.scene, 'sam_settings', None)
    if settings and 0 <= settings.active_layer_index < len(material_nodes):
        selected_node = material_nodes[settings.active_layer_index]
        if (selected_node.type == 'GROUP' and selected_node.node_tree
                and SAM_has_layer_name(selected_node)):
            return selected_node.node_tree.nodes

    first_layer = next(
        (node for node in material_nodes
         if node.type == 'GROUP' and node.node_tree
         and SAM_has_layer_name(node)),
        None,
    )
    return first_layer.node_tree.nodes if first_layer else material_nodes

def SAM_get_mapping_scale(self):
    obj = bpy.context.object
    if not obj or obj.type != 'MESH' or not obj.active_material:
        return 1.0

    nodes = SAM_get_edit_nodes(bpy.context, obj.active_material)
    for node in nodes or ():
        if node.type == 'MAPPING':
            return node.inputs['Scale'].default_value[0]
    return 1.0

def SAM_set_mapping_scale(self, value):
    obj = bpy.context.object
    if not obj or obj.type != 'MESH' or not obj.active_material:
        return

    nodes = SAM_get_edit_nodes(bpy.context, obj.active_material)
    for node in nodes or ():
        if node.type == 'MAPPING':
            node.inputs['Scale'].default_value[0] = value
            node.inputs['Scale'].default_value[1] = value
            node.inputs['Scale'].default_value[2] = value
            return

def SAM_get_layer_opacity_node(layer_node):
    if not layer_node.node_tree:
        return None
    masks_group = next(
        (node for node in layer_node.node_tree.nodes
         if node.type == 'GROUP' and node.label == "Masks" and node.node_tree),
        None,
    )
    if not masks_group:
        return None
    return next(
        (node for node in masks_group.node_tree.nodes
         if node.type == 'VALUE' and node.label == "const_layerOp"),
        None,
    )

def SAM_get_layer_opacity(self):
    node = SAM_get_layer_opacity_node(self)
    return node.outputs[0].default_value if node else 1.0

def SAM_set_layer_opacity(self, value):
    node = SAM_get_layer_opacity_node(self)
    if node:
        node.outputs[0].default_value = value

def SAM_load_preview_icon(full_path, is_dir, image_exts, preview_collection):
    """
    Unified preview loader for both folders and files.
    - Folders: find color map first, else first image.
    - Files: load the file itself.
    """

    # ---------------------------
    # FILE PREVIEW
    # ---------------------------
    if not is_dir:
        ext = os.path.splitext(full_path)[1].lower()
        if ext in image_exts:
            icon_name = full_path
            if icon_name not in preview_collection:
                preview_collection.load(icon_name, full_path, 'IMAGE')
            return preview_collection[icon_name].icon_id
        return 0

    # ---------------------------
    # FOLDER PREVIEW
    # ---------------------------
    try:
        entries = sorted(os.listdir(full_path), key=str.lower)
    except FileNotFoundError:
        return 0

    image_files = []
    for name in entries:
        sub = os.path.join(full_path, name)
        if not os.path.isfile(sub):
            continue

        ext = os.path.splitext(name)[1].lower()
        if ext in image_exts:
            image_files.append(name)

    if not image_files:
        return 0

    # Prefer suffix category "color"
    for name in image_files:
        category = SAM_detect_suffix(name, SAM_SUFFIXES)
        if category == "color":
            chosen = name
            break
    else:
        chosen = image_files[0]

    chosen_full = os.path.join(full_path, chosen)
    icon_name = chosen_full

    if icon_name not in preview_collection:
        preview_collection.load(icon_name, chosen_full, 'IMAGE')

    return preview_collection[icon_name].icon_id

def SAM_refresh_list(settings):
    global preview_collection
    folder = settings.folder_path
    settings.items.clear()
    

    abs_path = bpy.path.abspath(folder)
    if not os.path.isdir(abs_path):
        return

    IMAGE_EXTS = {
        ".jpg", ".jpeg", ".exr", ".png", ".webp", ".avif",
        ".bmp", ".cin", ".dpx", ".sgi", ".rgb", ".bw",
        ".jp2", ".j2c", ".hdr", ".tga", ".tif", ".tiff"
    }

    entries = sorted(
        os.listdir(abs_path),
        key=lambda e: (not os.path.isdir(os.path.join(abs_path, e)), e.lower())
    )
    
    for entry in entries:
        full = os.path.join(abs_path, entry)

        # Skip dot-hidden folders 
        if entry.startswith("."):
            continue

        # Skip Windows hidden/system folders
        try:
            import ctypes
            FILE_ATTRIBUTE_HIDDEN = 0x2
            FILE_ATTRIBUTE_SYSTEM = 0x4

            attrs = ctypes.windll.kernel32.GetFileAttributesW(full)
            if attrs != -1 and (attrs & (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM)):
                continue
        except:
            pass

        
        is_dir = os.path.isdir(full)

        #list folders
        if is_dir:
            item = settings.items.add()
            item.name = entry
            item.is_dir = is_dir
            item.icon_id = SAM_load_preview_icon(full, True, IMAGE_EXTS, preview_collection)
            continue

        #skip files if show_files is False
        if not is_dir and not settings.show_files :
            continue

        #list files and load previews if show_files is True
        ext = os.path.splitext(entry)[1].lower()
        if not is_dir and settings.show_files and ext in IMAGE_EXTS :
            item = settings.items.add()
            item.name = entry
            item.is_dir = is_dir
            item.icon_id = SAM_load_preview_icon(full, False, IMAGE_EXTS, preview_collection)

def SAM_detect_suffix(entry_name, suffix_map):
    name = entry_name.lower()
    name_no_ext = os.path.splitext(name)[0]
    if "_" in name_no_ext:
        suffix = name_no_ext.split("_")[-1]
    else:
        suffix = name_no_ext

    for category, suffixes in suffix_map.items():
        for suf in suffixes:
            if suffix  == suf:
                return category
    return None

def SAM_hex_to_rgb(hex_color):
    hex_color = hex_color.lstrip('#')
    return tuple(int(hex_color[i:i+2], 16) / 255 for i in (0, 2, 4))

