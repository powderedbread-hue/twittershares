class SAM_OT_rough_mult(bpy.types.Operator):
    bl_idname = "sam.rough_mult"
    bl_label = "Rough Mult"
    bl_description = "Insert  Multiply for roughness texture "
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        obj = context.object
        mat = obj.active_material if obj else None
        if not mat or not mat.use_nodes:
            self.report({'WARNING'}, "Active object has no node material")
            return {'CANCELLED'}

        nodes = SAM_get_edit_nodes(context, mat)
        if not nodes:
            return {'CANCELLED'}
        links = nodes[0].id_data.links
        inserted = 0
        already_inserted = False

        for bsdf in (node for node in nodes if node.type == 'BSDF_PRINCIPLED'):
            roughness = bsdf.inputs.get('Roughness')
            if not roughness or not roughness.is_linked:
                continue

            source_link = roughness.links[0]
            source_node = source_link.from_node
            if source_node.type == 'MATH' and source_node.operation == 'MULTIPLY':
                already_inserted = True
                continue
            if source_node.type != 'TEX_IMAGE':
                continue

            source_socket = source_link.from_socket
            multiply = nodes.new('ShaderNodeMath')
            multiply.label = "mult_rough"
            multiply.operation = 'MULTIPLY'
            multiply.inputs[1].default_value = 1.0
            multiply.location = (
                (source_node.location.x + bsdf.location.x) / 2,
                (source_node.location.y + bsdf.location.y) / 2,
            )

            links.remove(source_link)
            links.new(source_socket, multiply.inputs[0])
            links.new(multiply.outputs['Value'], roughness)
            inserted += 1

        if inserted:
            self.report({'INFO'}, f"Added roughness multiply node to {inserted} connection(s)")
            return {'FINISHED'}
        if already_inserted:
            self.report({'INFO'}, "Roughness already has a Multiply node")
            return {'CANCELLED'}

        self.report({'WARNING'}, "No image texture is directly connected to a Principled Roughness input")
        return {'CANCELLED'}



