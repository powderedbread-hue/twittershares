        name="Show Files",
        default=False,
        description="Show files in the directory list",
        update=SAM_folder_update,   # auto-refresh when toggled
)

    mapping_scale: bpy.props.FloatProperty(
        name="Scale",
        description="Set the mapping scale for X, Y, and Z",
