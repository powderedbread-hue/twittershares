class SAM_OT_activate_layer(bpy.types.Operator):
    bl_idname = "sam.activate_layer"
    bl_label = "Edit Layer"
    bl_description = "Set this layer as the active editing target"

    layer_index: bpy.props.IntProperty(options={'HIDDEN'})
    layer_name: bpy.props.StringProperty(options={'HIDDEN'})
    paint: bpy.props.BoolProperty(default=False, options={'HIDDEN'})

    def execute(self, context):
        settings = context.scene.sam_settings
        settings.active_layer_index = self.layer_index
        obj = context.object
        color_attribute = obj.data.color_attributes.get(self.layer_name)
        active_color = obj.data.color_attributes.active_color
        if (self.paint and obj.mode == 'VERTEX_PAINT'
                and active_color and active_color.name == self.layer_name):
            bpy.ops.object.mode_set(mode='OBJECT')
