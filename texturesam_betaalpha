        return {'FINISHED'}


class SAM_OT_rename_layer(bpy.types.Operator):
    bl_idname = "sam.rename_layer"
    bl_label = "Rename Layer"
    bl_description = "Rename the selected layer and its color attribute"
    bl_options = {'REGISTER', 'UNDO'}

    node_name: bpy.props.StringProperty(options={'HIDDEN'})
    new_name: bpy.props.StringProperty(name="Layer Name")

    @classmethod
    def poll(cls, context):
        return bool(context.object and context.object.type == 'MESH' and context.object.active_material)

    def invoke(self, context, event):
        node = context.object.active_material.node_tree.nodes.get(self.node_name)
        if not node:
            return {'CANCELLED'}
        self.new_name = node.label or node.name
        return context.window_manager.invoke_props_dialog(self, width=250, confirm_text="OK")

    def draw(self, context):
        self.layout.prop(self, "new_name")

    def execute(self, context):
        obj = context.object
        node = obj.active_material.node_tree.nodes.get(self.node_name)
        new_name = self.new_name.strip()
        if not node or not new_name:
            return {'CANCELLED'}

        old_name = node.label or node.name
        attributes = obj.data.color_attributes
        if new_name != old_name and new_name in attributes:
            self.report({'ERROR'}, f"Color attribute '{new_name}' already exists")
            return {'CANCELLED'}

        attribute = attributes.get(old_name)
        if attribute:
            attribute.name = new_name
        node['sam_layer'] = True
        node.label = new_name
        node.node_tree.name = new_name

        for masks in node.node_tree.nodes:
            if masks.type == 'GROUP' and masks.label == "Masks" and masks.node_tree:
                for mask_node in masks.node_tree.nodes:
                    if mask_node.type == 'VERTEX_COLOR':
                        mask_node.layer_name = new_name
                masks.node_tree.update_tag()

        # Cycling the active attribute is what makes the shader editor stop flagging the name red
        renamed = attributes.get(new_name)
        if renamed:
            previous = attributes.active_color
            previous_name = new_name if previous is None or previous.name == old_name else previous.name
            other = next((attr for attr in attributes if attr.name != new_name), None)
            if other:
                attributes.active_color = other
            attributes.active_color = renamed
            restore = attributes.get(previous_name)
            if restore:
                attributes.active_color = restore

        obj.data.update()
        obj.update_tag()
        node.node_tree.update_tag()
        obj.active_material.node_tree.update_tag()
        for area in context.screen.areas:
            area.tag_redraw()
        return {'FINISHED'}


class SAM_OT_delete_layer(bpy.types.Operator):
    bl_idname = "sam.delete_layer"
    bl_label = "Delete Layer"
    bl_description = "Delete the selected layer and its color attribute, keeping the chain connected"
    bl_options = {'REGISTER', 'UNDO'}

    node_name: bpy.props.StringProperty(options={'HIDDEN'})

    @classmethod
    def poll(cls, context):
        return bool(context.object and context.object.type == 'MESH' and context.object.active_material)

    def execute(self, context):
        obj = context.object
        tree = obj.active_material.node_tree
        node = tree.nodes.get(self.node_name)
        if not node:
            return {'CANCELLED'}

        # Last layer in the chain feeds the material output directly
        deleted_x = node.location.x
        feeding_outputs = [
            link.to_node for link in node.outputs['BSDF'].links
            if link.to_node.type == 'OUTPUT_MATERIAL'
        ]

        # Bridge each upstream source to whatever the layer fed, so the chain stays connected
        upstream_node = None
        for socket_name in ('BSDF', 'Displacement'):
            layer_input = node.inputs.get(socket_name)
            layer_output = node.outputs.get(socket_name)
            if not layer_input or not layer_output:
                continue
            source = layer_input.links[0].from_socket if layer_input.is_linked else None
            if source and socket_name == 'BSDF':
                upstream_node = layer_input.links[0].from_node
            for destination in [link.to_socket for link in layer_output.links]:
                if source:
                    tree.links.new(source, destination)

        layer_name = node.label or node.name
        layer_tree = node.node_tree
        masks_trees = [
            n.node_tree for n in layer_tree.nodes
            if n.type == 'GROUP' and n.label == "Masks" and n.node_tree
        ] if layer_tree else []



        tree.nodes.remove(node)
        for output_node in feeding_outputs:
            output_node.location.x = deleted_x
        for group in [layer_tree] + masks_trees:
            if group and group.users == 0:
                bpy.data.node_groups.remove(group)

        for layer in tree.nodes:
            if layer.type == 'GROUP' and SAM_has_layer_name(layer) and layer.node_tree:
                bottom_bool = next(
                    (n for n in layer.node_tree.nodes
                     if n.type == 'INPUT_BOOL' and n.label == "isBottomLayer"),
                    None,
                )
                if bottom_bool:
                    bottom_bool.boolean = not layer.inputs['BSDF'].is_linked

        settings = context.scene.sam_settings
        remaining = list(tree.nodes)
        if upstream_node and upstream_node.name in tree.nodes:
            settings.active_layer_index = remaining.index(upstream_node)
        else:
            settings.active_layer_index = next(
                (i for i, n in enumerate(remaining) if n.type == 'GROUP' and SAM_has_layer_name(n)),
                0,
            )

        if not any(n.type == 'GROUP' and SAM_has_layer_name(n) for n in remaining):
            mat = obj.active_material
            obj.data.materials.pop(index=obj.active_material_index)
            if mat.users == 0:
                bpy.data.materials.remove(mat)
        return {'FINISHED'}


class SAM_OT_duplicate_layer(bpy.types.Operator):
    bl_idname = "sam.duplicate_layer"
    bl_label = "Duplicate Layer"
    bl_description = "Duplicate the selected layer and its color attribute, inserting the copy right above it"
    bl_options = {'REGISTER', 'UNDO'}

    node_name: bpy.props.StringProperty(options={'HIDDEN'})

    @classmethod
    def poll(cls, context):
        return bool(context.object and context.object.type == 'MESH' and context.object.active_material)

    def execute(self, context):
        obj = context.object
        tree = obj.active_material.node_tree
        node = tree.nodes.get(self.node_name)
        if not node or not node.node_tree:
            return {'CANCELLED'}

        attributes = obj.data.color_attributes
        old_name = node.label or node.name
        new_name = f"{old_name}_copy"
        counter = 2
        while new_name in attributes or any((n.label or n.name) == new_name for n in tree.nodes):
            new_name = f"{old_name}_copy{counter}"
            counter += 1

        # Copy the layer group and give the copy its own Masks group
        new_tree = node.node_tree.copy()
        new_tree.name = new_name
        for inner in new_tree.nodes:
            if inner.type == 'GROUP' and inner.label == "Masks" and inner.node_tree:
                inner.node_tree = inner.node_tree.copy()
                for mask_node in inner.node_tree.nodes:
                    if mask_node.type == 'VERTEX_COLOR':
                        mask_node.layer_name = new_name

        # Make room, then place the copy just right of the original
        for other in tree.nodes:
            if other.location.x > node.location.x:
                other.location.x += 250
        new_node = tree.nodes.new('ShaderNodeGroup')
        new_node.node_tree = new_tree
        new_node.label = new_name
        new_node['sam_layer'] = True
        new_node.location = (node.location.x + 250, node.location.y)

        # Splice the copy in directly after the original
        for socket_name in ('BSDF', 'Displacement'):
            original_output = node.outputs.get(socket_name)
            new_input = new_node.inputs.get(socket_name)
            new_output = new_node.outputs.get(socket_name)
            if not all((original_output, new_input, new_output)):
                continue
            downstream = [link.to_socket for link in original_output.links]
            for link in list(original_output.links):
                tree.links.remove(link)
            tree.links.new(original_output, new_input)
            for destination in downstream:
                tree.links.new(new_output, destination)

        bottom_bool = next(
            (n for n in new_tree.nodes if n.type == 'INPUT_BOOL' and n.label == "isBottomLayer"),
            None,
        )
        if bottom_bool:
            bottom_bool.boolean = not new_node.inputs['BSDF'].is_linked

        # Duplicate the vertex color attribute under the new name
        original_attribute = attributes.get(old_name)
        if original_attribute:
            new_attribute = attributes.new(
                name=new_name,
                type=original_attribute.data_type,
                domain=original_attribute.domain,
            )
            buffer = [0.0] * (len(original_attribute.data) * 4)
            original_attribute.data.foreach_get("color", buffer)
            new_attribute.data.foreach_set("color", buffer)
        else:
            attributes.new(name=new_name, type='BYTE_COLOR', domain='CORNER')

        context.scene.sam_settings.active_layer_index = list(tree.nodes).index(new_node)
        obj.data.update()
        tree.update_tag()
        return {'FINISHED'}


def SAM_load_suffix_images(path):
    # A single image file counts as the color map
    suffix_map = {key: None for key in SAM_SUFFIXES}
    single_image = os.path.isfile(path)
    files = [path] if single_image else [os.path.join(path, f) for f in os.listdir(path)]
    for full in files:
        if not os.path.isfile(full):
            continue
        category = "color" if single_image else SAM_detect_suffix(os.path.basename(full), SAM_SUFFIXES)
        if category in suffix_map:
            try:
                suffix_map[category] = bpy.data.images.load(full, check_existing=True)
            except RuntimeError:
                pass
    return suffix_map


class SAM_OT_replace_layer(bpy.types.Operator):
    bl_idname = "sam.replace_layer"
    bl_label = "Replace Layer"
    bl_description = "Rebuild the selected layer's textures from the selected folder, keeping its mask and vertex colors"
    bl_options = {'REGISTER', 'UNDO'}

    node_name: bpy.props.StringProperty(options={'HIDDEN'})
    folder_path: bpy.props.StringProperty(options={'HIDDEN'})

    @classmethod
    def poll(cls, context):
        return bool(context.object and context.object.type == 'MESH' and context.object.active_material)

    def execute(self, context):
        tree = context.object.active_material.node_tree
        layer = tree.nodes.get(self.node_name)
        if not layer or not layer.node_tree:
            return {'CANCELLED'}
        if not os.path.exists(self.folder_path):
            self.report({'ERROR'}, "Folder does not exist")
            return {'CANCELLED'}

        gn = layer.node_tree.nodes
        gl = layer.node_tree.links
        bsdf = next((n for n in gn if n.type == 'BSDF_PRINCIPLED'), None)
        disp = next((n for n in gn if n.type == 'DISPLACEMENT'), None)
        mapping = next((n for n in gn if n.type == 'MAPPING'), None)
        mix_color = next((n for n in gn if n.label == "Mix_Color"), None)
        masks = next((n for n in gn if n.label == "Masks"), None)
        if not (bsdf and disp and mix_color):
            self.report({'ERROR'}, "The selected node is not a Samurai layer")
            return {'CANCELLED'}

        images = SAM_load_suffix_images(self.folder_path)
        projection = next((n.projection for n in gn if n.type == 'TEX_IMAGE'), 'FLAT')

        # Drop the old image nodes (plus the Normal Map and AO multiply) and add only what the folder has
        for n in [n for n in gn if n.type in {'TEX_IMAGE', 'NORMAL_MAP', 'MIX_RGB'}]:
            gn.remove(n)

        y = 200

        def add_tex(key, non_color=True):
            nonlocal y
            tex = gn.new("ShaderNodeTexImage")
            tex.image = images[key]
            tex.projection = projection
            tex.location = (bsdf.location.x - 800, y)
            y -= 300
            if non_color:
                tex.image.colorspace_settings.name = 'Non-Color'
            if mapping:
                gl.new(mapping.outputs["Vector"], tex.inputs["Vector"])
            return tex

        color = add_tex("color", False) if images["color"] else None
        if color and images["ao"]:
            ao = add_tex("ao")
            multiply = gn.new("ShaderNodeMixRGB")
            multiply.blend_type = 'MULTIPLY'
            multiply.location = (color.location.x + 300, color.location.y)
            gl.new(color.outputs["Color"], multiply.inputs["Color1"])
            gl.new(ao.outputs["Color"], multiply.inputs["Color2"])
            gl.new(multiply.outputs["Color"], mix_color.inputs["B"])
        elif color:
            gl.new(color.outputs["Color"], mix_color.inputs["B"])

        for key, socket in (
            ("roughness", bsdf.inputs["Roughness"]),
            ("metallic", bsdf.inputs["Metallic"]),
            ("emission", bsdf.inputs["Emission Color"]),
            ("height", disp.inputs["Height"]),
        ):
            if images[key]:
                gl.new(add_tex(key).outputs["Color"], socket)

        if images["emission"]:
            bsdf.inputs["Emission Strength"].default_value = 1.0
        if images["normal"]:
            tex = add_tex("normal")
            normal_map = gn.new("ShaderNodeNormalMap")
            normal_map.location = (tex.location.x + 300, tex.location.y)
            gl.new(tex.outputs["Color"], normal_map.inputs["Color"])
            gl.new(normal_map.outputs["Normal"], bsdf.inputs["Normal"])

        # Alpha feeds the layer's mask when it has an Alpha input
        alpha_socket = masks.inputs.get("Alpha") if masks else None
        if images["alpha"]:
            gl.new(add_tex("alpha").outputs["Color"], alpha_socket or bsdf.inputs["Alpha"])
        elif alpha_socket:
            alpha_socket.default_value = 1.0

        if images["height"]:
            if disp.inputs["Scale"].default_value == 0:
                disp.inputs["Scale"].default_value = 0.1
        else:
            disp.inputs["Height"].default_value = 0.5

        layer.node_tree.update_tag()
        for screen in bpy.data.screens:
            for area in screen.areas:
                area.tag_redraw()
        return {'FINISHED'}


class SAM_OT_add_layer(bpy.types.Operator):
    bl_idname = "sam.add_layer"
    bl_label = "Add Layer"
    bl_description = "Add a layer from the selected folder, converting the current material first if needed"
