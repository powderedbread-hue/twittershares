class SAM_OT_subdiv(bpy.types.Operator):
    bl_idname = "sam.button_subdiv"
    bl_label = "Simple Subdiv"
    bl_options = {'REGISTER', 'UNDO'}                                 
    bl_description = "Add a 'simple' subdiv mod to selected object(s)"


    def execute(self, context):
        selected = context.selected_objects

        if not selected:
            self.report({'WARNING'}, "No objects selected")
            return {'CANCELLED'}

        # Store original active object
        original_active = context.view_layer.objects.active

        for obj in selected:
            if obj.type != 'MESH':
                continue

            # Make this object active so modifier_add works
            context.view_layer.objects.active = obj

            # Add subdivision modifier
            mod = obj.modifiers.new(name="Subdivision", type='SUBSURF')
            mod.subdivision_type = 'SIMPLE'
            mod.levels = 1
            mod.render_levels = 1
      
            if context.scene.render.engine == 'CYCLES':
                #obj.cycles.use_adaptive_subdivision = True
                obj.modifiers["Subdivision"].use_adaptive_subdivision = True
          
        context.view_layer.objects.active = original_active

        self.report({'INFO'}, "Subdivision added to selected objects")
        return {'FINISHED'} 


class SAM_OT_box_projection(bpy.types.Operator):
    bl_idname = "sam.box_projection"
    bl_label = "Box"
    bl_options = {'REGISTER', 'UNDO'}
    bl_description = "Apply box projection to selected object's textures"
    

    def execute(self, context):
        context.scene.sam_settings.projection_style = 'BOX'
        updated = 0

        for obj in context.selected_objects:
            mat = obj.active_material
            if not mat or not mat.use_nodes:
                continue

            nodes = SAM_get_edit_nodes(context, mat)
            if not nodes:
                continue
            texcoord = next((node for node in nodes if node.type == 'TEX_COORD'), None)
            mapping = next((node for node in nodes if node.type == 'MAPPING'), None)
            if not texcoord or not mapping:
                continue

            nodes[0].id_data.links.new(texcoord.outputs['Object'], mapping.inputs['Vector'])
            for node in nodes:
                if node.type == 'TEX_IMAGE':
                    node.projection = 'BOX'
            updated += 1

        if updated:
            self.report({'INFO'}, f"Box projection applied to {updated} object(s)")
            return {'FINISHED'}

        self.report({'WARNING'}, "No selected objects had a material with both required nodes")
        return {'CANCELLED'}


