# Operator: up one level
# ---------------------------------------------------------    

class SAM_OT_up_one(bpy.types.Operator):
    bl_idname = "sam.up_one"
    bl_label = "Up One Level"
    bl_options = {'REGISTER', 'UNDO'}   
    bl_description = "Moves to parent directory"

    def execute(self, context):
        settings = context.scene.sam_settings

        path = settings.folder_path      #cancels if no path
        if not path:
            return {'CANCELLED'}
        
        cleanPath = path.rstrip("/\\")    #strips slashes at end of path
        drive, tail = os.path.splitdrive(cleanPath)
        if drive and (tail == "" or tail in ["\\", "/"]):
            return {'CANCELLED'}

        # ---------------------------------------------------------
        # RELATIVE PATH (implausible but whatever)
        # ---------------------------------------------------------
        if cleanPath.startswith("//"):
            abs_path = bpy.path.abspath(cleanPath)
            parent_abs = os.path.dirname(abs_path)
            project_root = bpy.path.abspath("//")

            # If parent is project root → go to "//"
            if os.path.normpath(parent_abs) == os.path.normpath(project_root):
                settings.folder_path = "//"
                return {'FINISHED'}

            # Otherwise convert parent back to Blender-relative
            rel = os.path.relpath(parent_abs, project_root)
            rel = rel.replace("\\", "/")
            settings.folder_path = "//" + rel
            return {'FINISHED'}

        # ---------------------------------------------------------
        # ABSOLUTE PATH (Windows, Linux, etc)
        # ---------------------------------------------------------
        parent = os.path.dirname(cleanPath)
        settings.folder_path = parent
        return {'FINISHED'}


