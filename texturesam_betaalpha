class SAM_Settings(bpy.types.PropertyGroup):
    
    folder_path: bpy.props.StringProperty(
        name="Folder",
        default="//",              
        subtype='DIR_PATH',
        update=SAM_folder_update,
    )

    items: bpy.props.CollectionProperty(type=SAM_Item)
    active_index: bpy.props.IntProperty(default=0)
