SAM_SUFFIXES = {
    "ao": ["ao", "ambientocclusion", "occlusion"],
    "color": ["color", "albedo", "basecolor", "diffuse"],
    "roughness": ["rough", "roughness"],
    "normal": ["normal", "nrm", "norm"],
    "metallic": ["metal", "metallic"],
    "alpha": ["alpha", "opacity", "transparency", "mask"],
    "height": ["height", "disp", "displacement"],
    "emission": ["emission", "emit", "emissive"],
}






