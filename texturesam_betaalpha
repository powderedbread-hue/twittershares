    bl_region_type = 'UI'
    bl_category = "Samurai"

    def draw_header(self, context):
        self.layout.label(text="", icon='EMPTY_AXIS')

    def draw(self, context):
        layout = self.layout


        obj = context.object

        # No object selected
        if not obj or obj.type != 'MESH':
            layout.label(text="No object selected")
            return

        mat = obj.active_material
        if not mat or not mat.use_nodes:
            layout.label(text="No material / no nodes")
            return

        nodes = SAM_get_edit_nodes(context, mat)
        if not nodes:
            layout.label(text="No material nodes found")
            return

        # Find Mapping node
        mapping_node = None
        for n in nodes:
            if n.type == 'MAPPING':
                mapping_node = n
                break

        if mapping_node:
            layout.label(text="Texture Mapping")
            split = layout.split(factor=0.8, align=True)
            controls = split.row(align=True)
            controls.scale_y = 2
            controls.prop(context.scene.sam_settings, "mapping_scale", text="Scale")
            controls.prop(mapping_node.inputs['Rotation'], "default_value", index=2, text="Rot")

            arrows = split.row(align=True)
            arrows.scale_y = 2
            rotate_left = arrows.operator(
                "sam.rotate_mapping_90",
                text="↰",
                emboss=True,
            )
            rotate_left.direction = -1
            rotate_right = arrows.operator(
                "sam.rotate_mapping_90",
                text="↱",
                emboss=True,
            )
            rotate_right.direction = 1
        else:
            layout.label(text="No Mapping node found")
        # Find Displacement node
        disp_node = None
        for n in nodes:
            if n.type == 'DISPLACEMENT':
                disp_node = n
                break

        if not disp_node:
            layout.label(text="No Displacement node found")
            return

        layout.label(text="Displacement Settings")
        normal_map_node = next(
            (node for node in nodes if node.type == 'NORMAL_MAP'),
            None,
        )
        if normal_map_node:
            layout.prop(normal_map_node.inputs['Strength'], "default_value", text="Normal Strength")
        layout.prop(disp_node.inputs['Scale'], "default_value", text="Height")
        layout.prop(disp_node.inputs['Midlevel'], "default_value", text="Midlevel")



