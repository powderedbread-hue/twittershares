def SAM_find_upstream_image(socket):
    if not socket or not socket.is_linked:
        return None
    queue = [socket.links[0].from_node]
    seen = set()
    while queue:
        node = queue.pop(0)
        if node.as_pointer() in seen:
            continue
        seen.add(node.as_pointer())
        if node.type == 'TEX_IMAGE' and node.image:
            return node.image
        queue.extend(s.links[0].from_node for s in node.inputs if s.is_linked)
    return None


class SAM_PT_base_files(bpy.types.Panel):
    bl_label = "Base Files"
    bl_idname = "SAM_PT_base_files"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Samurai"
    bl_parent_id = "SAM_PT_layers"
    bl_options = {'DEFAULT_CLOSED'}

    def draw(self, context):
        layout = self.layout
        obj = context.object
        mat = obj.active_material if obj and obj.type == 'MESH' else None
        if not mat or not mat.use_nodes:
            layout.label(text="No layered material")
            return

        settings = context.scene.sam_settings
        layer = None
        if 0 <= settings.active_layer_index < len(mat.node_tree.nodes):
            candidate = mat.node_tree.nodes[settings.active_layer_index]
            if candidate.type == 'GROUP' and candidate.node_tree and SAM_has_layer_name(candidate):
                layer = candidate
        if layer is None:
            layer = next(
                (n for n in mat.node_tree.nodes
                 if n.type == 'GROUP' and n.node_tree and SAM_has_layer_name(n)),
                None,
            )
        # No layer groups: read the plain material's own nodes
        layer_nodes = layer.node_tree.nodes if layer else mat.node_tree.nodes
        bsdf = next((n for n in layer_nodes if n.type == 'BSDF_PRINCIPLED'), None)
        disp = next((n for n in layer_nodes if n.type == 'DISPLACEMENT'), None)
        slots = (
            ("Base Color", bsdf.inputs['Base Color'] if bsdf else None, 'COLOR'),
            ("Roughness", bsdf.inputs['Roughness'] if bsdf else None, 'SLIDER'),
            ("Metallic", bsdf.inputs['Metallic'] if bsdf else None, 'SLIDER'),
            ("Normal", bsdf.inputs['Normal'] if bsdf else None, 'NONE'),
            ("Height", disp.inputs['Height'] if disp else None, 'SLIDER'),
        )
        for label, socket, fallback in slots:
            image = SAM_find_upstream_image(socket)
            row = layout.split(factor=0.35, align=True)
            row.scale_y = 1.5
            row.label(text=label)
            if image:
                row.prop(image, "filepath", text="")
            elif socket is None:
                row.label(text="")
            elif socket.is_linked:
                row.label(text="Linked")
            elif fallback == 'COLOR':
                row.prop(socket, "default_value", text="")
            elif fallback == 'SLIDER':
                row.prop(socket, "default_value", text="", slider=True)
            else:
                row.label(text="")


class SAM_OT_group_material_nodes(bpy.types.Operator):
    bl_idname = "sam.group_material_nodes"
    bl_label = "Layer Mode"
    bl_description = "Convert Material to Layer group"
    bl_options = {'REGISTER', 'UNDO'}

    new_layer: bpy.props.BoolProperty(default=False, options={'HIDDEN'})
    folder_path: bpy.props.StringProperty(options={'HIDDEN'})

    def execute(self, context):
        obj = context.object
        original_materials = [(selected_obj, selected_obj.active_material)
                              for selected_obj in context.selected_objects]
        original_mat = obj.active_material
        original_output = None
        original_surface = None
        original_surface_source = None
        original_displacement_source = None

        if self.new_layer:
            if original_mat and original_mat.use_nodes:
                original_output = next(
                    node for node in original_mat.node_tree.nodes
                    if node.type == 'OUTPUT_MATERIAL' and node.is_active_output
                )
                original_surface = original_output.inputs['Surface']
                original_surface_source = original_surface.links[0].from_socket
                displacement_links = original_output.inputs['Displacement'].links
                if displacement_links:
                    original_displacement_source = displacement_links[0].from_socket

            result = bpy.ops.sam.make_pbr(folder_path=self.folder_path)
            if 'FINISHED' not in result:
                return {'CANCELLED'}
            generated_mat = obj.active_material

        mat = obj.active_material
        nodes = mat.node_tree.nodes
        active_output = None
        surface = None

        active_output = next(
            node for node in nodes
            if node.type == 'OUTPUT_MATERIAL' and node.is_active_output
        )
        if active_output != None:
            surface = active_output.inputs['Surface']

        # Check if the surface input is linked and not already connected to a group node
        if not surface.is_linked or surface.links[0].from_node.type == 'GROUP':
            #self.report({'ERROR'}, "Material already grouped or not connected")
            return {'CANCELLED'}
        
        nodes_to_group = [node for node in nodes if node.type != 'OUTPUT_MATERIAL']
        surface_link = surface.links[0]
        surface_source_node = surface_link.from_node
        surface_source_index = list(surface_source_node.outputs).index(surface_link.from_socket)
        has_displacement_output = active_output.inputs['Displacement'].is_linked
        link_specs = [
            (
                link.from_node,
                list(link.from_node.outputs).index(link.from_socket),
                link.to_node,
                list(link.to_node.inputs).index(link.to_socket),
            )
            for link in mat.node_tree.links
            if link.from_node in nodes_to_group and link.to_node in nodes_to_group
        ]

        group_tree = bpy.data.node_groups.new("Layer_0", 'ShaderNodeTree')
        group_interface = group_tree.interface
        for socket_name, direction, socket_type in (
            ("BSDF", 'INPUT', 'NodeSocketShader'),
            ("BSDF", 'OUTPUT', 'NodeSocketShader'),
            ("Color", 'OUTPUT', 'NodeSocketColor'),
            ("Color", 'INPUT', 'NodeSocketColor'),
            ("Rough", 'OUTPUT', 'NodeSocketColor'),
            ("Rough", 'INPUT', 'NodeSocketColor'),
            ("Normal", 'OUTPUT', 'NodeSocketVector'),
            ("Normal", 'INPUT', 'NodeSocketVector'),
            ("Displacement", 'OUTPUT', 'NodeSocketVector'),
            ("Displacement", 'INPUT', 'NodeSocketVector'),
        ):
            group_interface.new_socket(
                name=socket_name,
                in_out=direction,
                socket_type=socket_type,
            )

        group_nodes = group_tree.nodes
        group_input = group_nodes.new('NodeGroupInput')
        group_output = group_nodes.new('NodeGroupOutput')
        group_input.location = (-1000, 0)
        group_output.location = (1200, 0)
        node_map = {}
        skipped_properties = {
            'rna_type', 'name', 'type', 'bl_idname', 'id_data', 'inputs',
            'outputs', 'internal_links', 'location', 'location_absolute',
            'dimensions', 'parent', 'select',
        }

        for source_node in nodes_to_group:
            copied_node = group_nodes.new(source_node.bl_idname)
            node_map[source_node.as_pointer()] = copied_node
            for prop in source_node.bl_rna.properties:
                if prop.is_readonly or prop.identifier in skipped_properties:
                    continue
                try:
                    setattr(copied_node, prop.identifier, getattr(source_node, prop.identifier))
                except (AttributeError, TypeError, ValueError, RuntimeError):
                    pass
            copied_node.location = source_node.location
            copied_node.width = source_node.width
            copied_node.label = source_node.label
            copied_node.hide = source_node.hide

        for source_node in nodes_to_group:
            copied_node = node_map[source_node.as_pointer()]
            if source_node.parent:
                copied_node.parent = node_map[source_node.parent.as_pointer()]
                copied_node.location = source_node.location
            for source_socket, copied_socket in zip(source_node.inputs, copied_node.inputs):
                if hasattr(source_socket, 'default_value') and hasattr(copied_socket, 'default_value'):
                    try:
                        copied_socket.default_value = source_socket.default_value
                    except (TypeError, ValueError, RuntimeError):
                        pass
            # RGB and Value nodes store their value on the output socket
            for source_socket, copied_socket in zip(source_node.outputs, copied_node.outputs):
                if hasattr(source_socket, 'default_value') and hasattr(copied_socket, 'default_value'):
                    try:
                        copied_socket.default_value = source_socket.default_value
                    except (TypeError, ValueError, RuntimeError):
                        pass

        for source_node, output_index, target_node, input_index in link_specs:
            group_tree.links.new(
                node_map[source_node.as_pointer()].outputs[output_index],
                node_map[target_node.as_pointer()].inputs[input_index],
            )

        layer_node = nodes.new('ShaderNodeGroup')
        layer_node.node_tree = group_tree
        layer_node.label = "Layer_0"
        layer_node['sam_layer'] = True
        layer_node.location = (active_output.location.x - 250, active_output.location.y)

        #make group input and output and change color 
        group_input = next(node for node in group_nodes if node.type == 'GROUP_INPUT')
        group_input.use_custom_color = True
        group_input.color = SAM_hex_to_rgb("#143551")
        group_output = next(node for node in group_nodes if node.type == 'GROUP_OUTPUT')
        group_output.use_custom_color = True
        group_output.color = SAM_hex_to_rgb("#143551")

        bsdf = next(node for node in group_nodes if node.type == 'BSDF_PRINCIPLED')
        displacement = next(
            (node for node in group_nodes if node.type == 'DISPLACEMENT'),
            None,
        )
        #mix shader
        mix_shader = group_nodes.new('ShaderNodeMixShader')
        #mix_shader.location = (bsdf.location.x + 600, bsdf.location.y + 200)
        mix_shader.inputs[0].default_value = 1
        mix_shader.label = "SAM_mix_shader"
        group_tree.links.new(mix_shader.outputs["Shader"], group_output.inputs["BSDF"])
        group_tree.links.new(group_input.outputs["BSDF"], mix_shader.inputs[1])
        group_tree.links.new(
            node_map[surface_source_node.as_pointer()].outputs[surface_source_index],
            mix_shader.inputs[2],
        )

        #mix color
        mix_color = group_nodes.new('ShaderNodeMix')
        mix_color.data_type = 'RGBA'
        mix_color.label = 'Mix_Color'

        mix_color.inputs[0].default_value = 1.0
        base_color_link = bsdf.inputs["Base Color"].links[0]
        group_tree.links.new(group_input.outputs["Color"], mix_color.inputs["A"])
        group_tree.links.new(base_color_link.from_socket, mix_color.inputs["B"])
        group_tree.links.new(mix_color.outputs["Result"], bsdf.inputs["Base Color"])
        group_tree.links.new(mix_color.outputs["Result"], group_output.inputs["Color"])
        
        #mix vector / displacement 
        mix_vector = group_nodes.new('ShaderNodeMix')
        mix_vector.data_type = 'VECTOR'
        mix_vector.inputs[0].default_value = 1.0
        #mix_vector.location = (mix_color.location.x, mix_color.location.y - 1100)
        group_tree.links.new(group_input.outputs["Displacement"], mix_vector.inputs["A"])
        group_tree.links.new(mix_vector.outputs["Result"], group_output.inputs["Displacement"])

        if displacement:
            group_tree.links.new(displacement.outputs["Displacement"], mix_vector.inputs["B"])

        for link in list(surface.links):
            mat.node_tree.links.remove(link)
        mat.node_tree.links.new(layer_node.outputs["BSDF"], surface)
        for source_node in nodes_to_group:
            nodes.remove(source_node)
        if has_displacement_output:
            mat.node_tree.links.new(
                layer_node.outputs['Displacement'],
                active_output.inputs['Displacement'],
            )


        if self.new_layer and original_mat and original_mat.use_nodes:
            for selected_obj, previous_mat in original_materials:
                selected_obj.active_material = previous_mat
            obj.active_material = original_mat
            original_nodes = original_mat.node_tree.nodes

            original_layer = original_nodes.new('ShaderNodeGroup')
            original_layer.node_tree = layer_node.node_tree
            original_layer.label = f"Layer_{sum(1 for node in original_nodes if node.type == 'GROUP' and SAM_has_layer_name(node))}"
            original_layer['sam_layer'] = True
            original_layer.node_tree.name = original_layer.label
            original_output.location.x += 250
            original_layer.location = (original_output.location.x - 250, original_output.location.y)

            surface = original_output.inputs['Surface']
            for link in list(surface.links):
                original_mat.node_tree.links.remove(link)
            original_mat.node_tree.links.new(original_surface_source, original_layer.inputs['BSDF'])
            original_mat.node_tree.links.new(original_layer.outputs['BSDF'], surface)

            if original_displacement_source:
                displacement_input = original_layer.inputs.get('Displacement')
                if displacement_input:
                    original_mat.node_tree.links.new(original_displacement_source, displacement_input)
            if original_displacement_source or has_displacement_output:
                original_mat.node_tree.links.new(
                    original_layer.outputs['Displacement'],
                    original_output.inputs['Displacement'],
                )

            if generated_mat.users == 0:
                bpy.data.materials.remove(generated_mat)



        elif self.new_layer:
            obj.active_material = generated_mat

        # A new layer never has a vertex color node yet; layer_node and original_layer share one tree
        final_layer = original_layer if self.new_layer and original_mat and original_mat.use_nodes else layer_node
        if final_layer.label not in obj.data.color_attributes:
            obj.data.color_attributes.new(name=final_layer.label, type='BYTE_COLOR', domain='CORNER')

        #final locations
        if bsdf:
            bsdf.location.x = bsdf.location.x + 300
        if mix_color:
            mix_color.location = (bsdf.location.x -250, bsdf.location.y + 250)
        if mix_shader:
            mix_shader.location = (bsdf.location.x +550, bsdf.location.y + 400)
        if mix_vector and displacement:
            mix_vector.location = (displacement.location.x+400, displacement.location.y+250)

        #mask mixing: nested group so more masks can be chained later
        alpha_bsdf = bsdf.inputs.get('Alpha')
        has_alpha = alpha_bsdf.is_linked
        mask_tree = bpy.data.node_groups.new("Masks", 'ShaderNodeTree')
        mask_interface = mask_tree.interface
        if has_alpha:
            mask_interface.new_socket(name="Alpha", in_out='INPUT', socket_type='NodeSocketFloat')
        mask_interface.new_socket(name="Factor", in_out='OUTPUT', socket_type='NodeSocketFloat')

        mask_nodes = mask_tree.nodes
        mask_in = mask_nodes.new('NodeGroupInput')
        mask_in.location = (-400, 0)
        mask_out = mask_nodes.new('NodeGroupOutput')
        mask_out.location = (700, 100)

        colorAtt_node = mask_nodes.new('ShaderNodeVertexColor')
        colorAtt_node.layer_name = final_layer.label
        colorAtt_node.location = (-200, 0)
        invert_colorAtt = mask_nodes.new('ShaderNodeInvert')
        invert_colorAtt.label = "invert_vertexColor"
        invert_colorAtt.location = (0, 0)
        mult_colorAtt = mask_nodes.new('ShaderNodeMath')
        mult_colorAtt.label = "mult_vertexColor"
        mult_colorAtt.operation = 'MULTIPLY'
        mult_colorAtt.location = (200, 0)
        sub_colorAtt = mask_nodes.new('ShaderNodeMath')
        sub_colorAtt.label = "sub_vertexColor"
        sub_colorAtt.operation = 'SUBTRACT'
        sub_colorAtt.location = (400, 200)
        const_vertexOpacity = mask_nodes.new('ShaderNodeValue')
        const_vertexOpacity.label = "const_vertexOp"
        const_vertexOpacity.location = (0, -100)
        const_vertexOpacity.outputs[0].default_value = 1.0
        const_layerOpacity = mask_nodes.new('ShaderNodeValue')
        const_layerOpacity.label = "const_layerOp"
        const_layerOpacity.location = (0, 150)
        const_layerOpacity.outputs[0].default_value = 1.0

        mask_links = mask_tree.links
        mask_links.new(colorAtt_node.outputs['Color'], invert_colorAtt.inputs['Color'])
        mask_links.new(invert_colorAtt.outputs['Color'], mult_colorAtt.inputs[0])
        mask_links.new(const_layerOpacity.outputs[0], sub_colorAtt.inputs[0])
        mask_links.new(const_vertexOpacity.outputs[0], mult_colorAtt.inputs[1])
        mask_links.new(mult_colorAtt.outputs[0], sub_colorAtt.inputs[1])
        mask_links.new(sub_colorAtt.outputs[0], mask_out.inputs['Factor'])

        masks_node = group_nodes.new('ShaderNodeGroup')
        masks_node.node_tree = mask_tree
        masks_node.label = "Masks"
        masks_node.location = (bsdf.location.x - 50, bsdf.location.y + 400)
        group_tree.links.new(masks_node.outputs['Factor'], mix_shader.inputs[0])
        group_tree.links.new(masks_node.outputs['Factor'], mix_vector.inputs[0])

        #boolean is Bottom Layer
        bool_isBottomLayer = group_nodes.new('FunctionNodeInputBool')
        bool_isBottomLayer.label = "isBottomLayer"
        bool_isBottomLayer.boolean = not final_layer.inputs['BSDF'].is_linked
        bool_isBottomLayer.location = (masks_node.location.x, masks_node.location.y + 200)
        node_transparencySafety = group_nodes.new('ShaderNodeBsdfTransparent')
        node_transparencySafety.location = (bool_isBottomLayer.location.x, bool_isBottomLayer.location.y - 100)
        mix_transparencySafety = group_nodes.new('ShaderNodeMixShader')
        mix_transparencySafety.label = "mix_proxy"
        mix_transparencySafety.location = (bool_isBottomLayer.location.x + 250, bool_isBottomLayer.location.y-50)
        group_tree.links.new(group_input.outputs['BSDF'], mix_transparencySafety.inputs[1])
        group_tree.links.new(node_transparencySafety.outputs['BSDF'], mix_transparencySafety.inputs[2])
        group_tree.links.new(bool_isBottomLayer.outputs[0], mix_transparencySafety.inputs['Fac'])
        group_tree.links.new(mix_transparencySafety.outputs['Shader'], mix_shader.inputs[1])

        #mask mixing base alpha
        if has_alpha:
            alpha_link = alpha_bsdf.links[0]
            invert_alpha = mask_nodes.new('ShaderNodeInvert')
            invert_alpha.label = "invert_alpha"
            invert_alpha.location = (-200, 300)
            sub_alpha = mask_nodes.new('ShaderNodeMath')
            sub_alpha.label = "sub_alpha"
            sub_alpha.operation = 'SUBTRACT'
            sub_alpha.location = (200, 250)

            const_layerOpacity.location = (0, 300)
            mask_links.new(mask_in.outputs['Alpha'], invert_alpha.inputs['Color'])
            mask_links.new(invert_alpha.outputs['Color'], sub_alpha.inputs[1])
            mask_links.new(const_layerOpacity.outputs[0], sub_alpha.inputs[0])
            mask_links.new(sub_alpha.outputs[0], sub_colorAtt.inputs[0])
            group_tree.links.new(alpha_link.from_socket, masks_node.inputs['Alpha'])
            group_tree.links.remove(alpha_link)

        active_nodes = obj.active_material.node_tree.nodes
        settings = context.scene.sam_settings
        settings.active_layer_index = next(
            (index for index, layer in enumerate(active_nodes)
             if layer == final_layer),
            settings.active_layer_index,
        )

        #original_output.location.x = original_output.location.x + 250
        #layer_node.location = (original_output.location.x - 250, original_output.location.y)
        

        return {'FINISHED'}


class SAM_OT_move_layer(bpy.types.Operator):
    bl_idname = "sam.move_layer"
    bl_label = "Move Layer"
    bl_options = {'REGISTER', 'UNDO'}

    direction: bpy.props.IntProperty(options={'HIDDEN'})

    def execute(self, context):
        obj = context.object
        mat = obj.active_material if obj and obj.type == 'MESH' else None
        if not mat or not mat.use_nodes:
            return {'CANCELLED'}

        settings = context.scene.sam_settings
        nodes = mat.node_tree.nodes
        if not 0 <= settings.active_layer_index < len(nodes):
            return {'CANCELLED'}
        selected_layer = nodes[settings.active_layer_index]
        layer_nodes = {
            node.as_pointer(): node
            for node in nodes
            if node.type == 'GROUP'
            and SAM_has_layer_name(node)
        }

        ordered_layers = []
        visited = set()

        def visit(source_node):
            pointer = source_node.as_pointer()
            if pointer in visited:
                return
            visited.add(pointer)

            if pointer in layer_nodes:
                bsdf_input = source_node.inputs.get('BSDF')
                if bsdf_input and bsdf_input.is_linked:
                    visit(bsdf_input.links[0].from_node)
                ordered_layers.append(source_node)
            elif source_node.type == 'MIX_SHADER':
                for socket_index in (1, 2):
                    socket_links = source_node.inputs[socket_index].links
                    if socket_links:
                        visit(socket_links[0].from_node)

        active_output = next(
            (node for node in nodes
             if node.type == 'OUTPUT_MATERIAL' and node.is_active_output),
            None,
        )
        surface = active_output.inputs.get('Surface') if active_output else None
        if surface and surface.is_linked:
            visit(surface.links[0].from_node)

        if selected_layer not in ordered_layers:
            return {'CANCELLED'}
        selected_index = ordered_layers.index(selected_layer)
        adjacent_index = selected_index + self.direction
        if not 0 <= adjacent_index < len(ordered_layers):
            return {'CANCELLED'}

        older_layer, newer_layer = sorted(
            (selected_layer, ordered_layers[adjacent_index]),
            key=ordered_layers.index,
        )
        tree_links = mat.node_tree.links
        for socket_name in ('BSDF', 'Displacement'):
            older_input = older_layer.inputs.get(socket_name)
            newer_input = newer_layer.inputs.get(socket_name)
            older_output = older_layer.outputs.get(socket_name)
            newer_output = newer_layer.outputs.get(socket_name)
            if not all((older_input, newer_input, older_output, newer_output)):
                continue

            older_source = older_input.links[0].from_socket if older_input.is_linked else None
            newer_input_links = list(newer_input.links)
            downstream_sockets = [link.to_socket for link in newer_output.links]
            for link in newer_input_links + list(newer_output.links):
                tree_links.remove(link)
            if older_input.is_linked:
                for link in list(older_input.links):
                    tree_links.remove(link)

            if older_source:
                tree_links.new(older_source, newer_input)
            tree_links.new(newer_output, older_input)
            for destination in downstream_sockets:
                tree_links.new(older_output, destination)

        older_location = older_layer.location.copy()
        older_layer.location = newer_layer.location
        newer_layer.location = older_location

        for layer in (older_layer, newer_layer):
            bottom_bool = next(
                (n for n in layer.node_tree.nodes
                 if n.type == 'INPUT_BOOL' and n.label == "isBottomLayer"),
                None,
            )
            if bottom_bool:
                bottom_bool.boolean = not layer.inputs['BSDF'].is_linked
        return {'FINISHED'}


class SAM_UL_layer_nodes(bpy.types.UIList):
    def filter_items(self, context, data, property_name):
        nodes = getattr(data, property_name)
        flags = [
            self.bitflag_filter_item if node.type == 'GROUP'
            and node.node_tree
            and node.node_tree.bl_idname == 'ShaderNodeTree'
            else 0
            for node in nodes
        ]

        layer_node_indices = {
            node.as_pointer(): index
            for index, node in enumerate(nodes)
            if node.type == 'GROUP'
            and SAM_has_layer_name(node)
        }
        ordered_indices = []
        visited_nodes = set()

        def visit_shader_source(source_node):
            pointer = source_node.as_pointer()
            if pointer in visited_nodes:
                return
            visited_nodes.add(pointer)

            if pointer in layer_node_indices:
                bsdf_input = source_node.inputs.get('BSDF')
                if bsdf_input and bsdf_input.is_linked:
                    visit_shader_source(bsdf_input.links[0].from_node)
                ordered_indices.append(layer_node_indices[pointer])
                return

            if source_node.type == 'MIX_SHADER':
                for socket_index in (1, 2):
                    socket_links = source_node.inputs[socket_index].links
                    if socket_links:
                        visit_shader_source(socket_links[0].from_node)

        active_output = next(
            (node for node in nodes
             if node.type == 'OUTPUT_MATERIAL' and node.is_active_output),
            None,
        )
        surface = active_output.inputs.get('Surface') if active_output else None
        if surface and surface.is_linked:
            visit_shader_source(surface.links[0].from_node)

        ordered_indices.reverse()
        ordered_indices.extend(
            index for index in layer_node_indices.values()
            if index not in ordered_indices
        )
        ordered_indices.extend(
            index for index, node in enumerate(nodes)
            if index not in ordered_indices
        )
        display_order = [0] * len(nodes)
        for display_index, original_index in enumerate(ordered_indices):
            display_order[original_index] = display_index
        return flags, display_order

    def draw_item(self, context, layout, data, item, icon, active_data, active_propname, index):
        row = layout.row(align=True)
        
        split = row.split(factor=0.5, align=True)
        name_row = split.row(align=True)
        name_row.alignment = 'LEFT'
        arrow_row = name_row.row(align=True)
        arrow_row.scale_x = 1.5
        arrow = arrow_row.operator(
            "sam.activate_layer",
            text="",
            icon='TRIA_RIGHT',
            emboss=True,
        )
        arrow.layer_index = index
        arrow.layer_name = item.label or item.name
        name_row.label(text=item.label or item.name)
        controls = split.row(align=True)
        obj = context.object
        active_color = obj.data.color_attributes.active_color if obj and obj.type == 'MESH' else None
        painting_this_layer = bool(
            obj and obj.mode == 'VERTEX_PAINT'
            and active_color and active_color.name == (item.label or item.name)
        )
        brush = controls.operator(
            "sam.activate_layer",
            text="",
            icon='BRUSH_DATA',
            emboss=True,
            depress=painting_this_layer,
        )
        brush.layer_index = index
        brush.layer_name = item.label or item.name
        brush.paint = True
        if SAM_get_layer_opacity_node(item):
            controls.prop(
                item,
                'sam_layer_opacity',
                text='',
                slider=True,
            )

