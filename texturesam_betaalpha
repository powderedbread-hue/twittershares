class SAM_PT_color(bpy.types.Panel):
    bl_label = "Color"
    bl_idname = "SAM_PT_color"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Samurai"

    def draw_header(self, context):
        self.layout.label(text="", icon='COLOR')

    def draw(self, context):

        layout = self.layout
        obj = context.object
        mat = obj.active_material if obj and obj.type == 'MESH' else None
        hsl_node = None
        bsdf_node = None
        rough_mult_node = None

        if mat and mat.use_nodes:
            nodes = SAM_get_edit_nodes(context, mat)
            for node in nodes or ():
                if node.type != 'BSDF_PRINCIPLED':
                    continue
                bsdf_node = node
                roughness = node.inputs.get('Roughness')
                if roughness and roughness.is_linked:
                    source_node = roughness.links[0].from_node
                    if source_node.type == 'MATH' and source_node.operation == 'MULTIPLY':
                        rough_mult_node = source_node

                base_color = node.inputs.get('Base Color')
                if not base_color:
                    continue
                hsl_node = next(
                    (
                        link.from_node for link in base_color.links
                        if link.from_node.bl_idname == 'ShaderNodeHueSaturation'
                        and link.from_socket.name == 'Color'
                    ),
                    None,
                )
                if hsl_node:
                    break

        if bsdf_node:
            ior_input = bsdf_node.inputs.get('IOR')
